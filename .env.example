# =============================================================
# Konfigurasi Supabase - TEMPLATE
#
# BERKAS INI DILACAK GIT. Jangan pernah mengisi nilainya di sini:
# apa pun yang ditulis di berkas ini ikut terdorong ke repository.
#
# Salin dulu menjadi .env.local, lalu isi nilainya di sana.
# .env.local sudah diabaikan git lewat pola `.env*` di .gitignore.
#
#   cp .env.example .env.local
#
# Ambil semua nilai di Supabase Dashboard > Project Settings > API.
# =============================================================

# URL project, mis. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Aman terbaca browser karena dibatasi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. RAHASIA - hanya dipakai di server (route /api/upload)
# untuk upsert batch. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Daftar email yang boleh mengunggah data di /admin, dipisahkan koma.
#
# Setiap user Supabase yang berhasil login sudah bisa membuka dashboard dan
# Tabel Data Detail; env ini hanya menentukan siapa yang boleh mengunggah.
# Bila dikosongkan, semua user yang login dianggap admin - selalu isi di
# produksi.
ADMIN_EMAILS=

# =============================================================
# Konfigurasi Supabase
# Salin file ini menjadi .env.local lalu isi nilainya.
# Ambil semua nilai di Supabase Dashboard > Project Settings > API.
# =============================================================

# URL project, mis. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Aman terbaca browser karena dibatasi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. RAHASIA - hanya dipakai di server (route /api/upload)
# untuk upsert batch. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Daftar email yang boleh membuka /admin dan mengunggah data,
# dipisahkan koma. Bila dikosongkan, semua user Supabase yang berhasil
# login dianggap admin - selalu isi ini di produksi.
ADMIN_EMAILS=
